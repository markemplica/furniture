# Safe production-oriented template. Replace every replace-with value and add
# secrets through the deployment secret manager. Never commit a real .env file.
APP_NAME=FurniCraft
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://beta.example.com
TRUSTED_PROXIES=
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=replace-with-database-host
DB_PORT=3306
DB_DATABASE=replace-with-database-name
DB_USERNAME=replace-with-least-privilege-user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=600
QUEUE_FAILED_DRIVER=database-uuids

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=replace-with-smtp-host
MAIL_PORT=587
MAIL_USERNAME=replace-with-smtp-username
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="FurniCraft"
ADMIN_FEEDBACK_EMAIL=
BETA_SEED_ACCOUNTS=false
BETA_ADMIN_NAME=
BETA_ADMIN_EMAIL=
BETA_ADMIN_PASSWORD=
BETA_CUSTOMER_NAME=
BETA_CUSTOMER_EMAIL=
BETA_CUSTOMER_PASSWORD=

# Only required if S3 storage or SQS queues are explicitly selected.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Gemini is optional; room planning falls back to local estimates when absent.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_FALLBACK_MODEL=gemini-2.5-flash-image

ROOM_IMAGE_RETENTION_DAYS=30
ROOM_PREVIEW_V2_ENABLED=false
ROOM_PREVIEW_V2_ROLLOUT_PERCENT=0
ROOM_PREVIEW_PIPELINE_VERSION=v2
ROOM_PREVIEW_BENCHMARK_GLOB=tests/Fixtures/room-*.png

VITE_APP_NAME="${APP_NAME}"
