# Safe production-oriented template. Replace every replace-with value and add
# secrets through the deployment secret manager. Never commit a real .env file.
APP_NAME=FurniCraft
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-production-domain.example
TRUSTED_PROXIES=
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# FurniCraft uses MySQL 8; XAMPP local installs normally use 127.0.0.1:3306.
# Create the database and a dedicated user before migrating; replace placeholders.
DB_CONNECTION=mysql
DB_HOST=replace-with-mysql-host
DB_PORT=3306
DB_DATABASE=replace-with-mysql-database
DB_USERNAME=replace-with-mysql-user
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=600
QUEUE_FAILED_DRIVER=database-uuids

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Optional absolute path to a persistent private volume with at least 5 GB free.
# Leave unset for storage/app/private.
# PRIVATE_STORAGE_ROOT=/var/lib/furnicraft/private

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=replace-with-smtp-host
MAIL_PORT=587
MAIL_USERNAME=replace-with-smtp-username
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="FurniCraft"
ADMIN_FEEDBACK_EMAIL=admin@example.test
# Shop contact number shown in reservation approval emails.
FURNICRAFT_SHOP_PHONE=
# Only required if S3 storage or SQS queues are explicitly selected.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Gemini is optional; room planning falls back to local estimates when absent.
GEMINI_API_KEY=

ROOM_IMAGE_RETENTION_DAYS=90
REGISTRATION_VERIFICATION_RETENTION_HOURS=24
ROOM_PREVIEW_V2_ENABLED=false
ROOM_PREVIEW_V2_ROLLOUT_PERCENT=0
ROOM_PREVIEW_PIPELINE_VERSION=v2
ROOM_PREVIEW_BENCHMARK_GLOB=tests/Fixtures/room-*.png

VITE_APP_NAME="${APP_NAME}"

# Aggregate attempted provider calls, UTC. Missing or zero limits block paid AI.
# Set shop-approved limits before paid AI use. These counts are not billing estimates.

# API spending: disabled until explicit request limits and USD allowances are approved.
GEMINI_ENABLED=false
# Optional fixed beta deadline in UTC, e.g. 2026-11-19T18:09:36Z.
# When set, a positive total beta allowance is required; its ledger never auto-resets.
GEMINI_BETA_EXPIRES_AT=
GEMINI_BETA_BUDGET_USD=0
GEMINI_DAILY_REQUEST_LIMIT=0
GEMINI_MONTHLY_REQUEST_LIMIT=0
GEMINI_DAILY_BUDGET_USD=0
GEMINI_MONTHLY_BUDGET_USD=0
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
GEMINI_IMAGE_FALLBACK_MODEL=
GEMINI_IMAGE_ENABLED=false
GEMINI_PROJECT_RPM=10
GEMINI_USER_RPM=5
GEMINI_USER_DAILY_LIMIT=20
GEMINI_USER_MONTHLY_LIMIT=200
AI_ALERT_EMAIL_ENABLED=false
