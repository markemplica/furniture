# Legacy beta-only template. Do not use for public production releases.
# Use .env.example for production and keep credentials in a secret manager.
APP_NAME=FurniCraft
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://replace-with-beta-domain.example
APP_TIMEZONE=Asia/Manila
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=replace-with-beta-database-host
DB_PORT=3306
DB_DATABASE=replace-with-beta-database-name
DB_USERNAME=replace-with-least-privilege-user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=600

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=replace-with-beta-smtp-host
MAIL_PORT=587
MAIL_USERNAME=replace-with-beta-smtp-username
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@replace-with-beta-domain.example
MAIL_FROM_NAME="FurniCraft Beta"
ADMIN_FEEDBACK_EMAIL=
BETA_SEED_ACCOUNTS=false
BETA_ADMIN_NAME=
BETA_ADMIN_EMAIL=
BETA_ADMIN_PASSWORD=
BETA_CUSTOMER_NAME=
BETA_CUSTOMER_EMAIL=
BETA_CUSTOMER_PASSWORD=

# Add the provider key through the host's secret manager only when Gemini
# consent, privacy copy, quota, and billing have been checked.
GEMINI_API_KEY=

ROOM_IMAGE_RETENTION_DAYS=90
REGISTRATION_VERIFICATION_RETENTION_HOURS=24
# Keep the new preview pipeline off until the beta operator explicitly enables it.
ROOM_PREVIEW_V2_ENABLED=false
ROOM_PREVIEW_V2_ROLLOUT_PERCENT=0
ROOM_PREVIEW_PIPELINE_VERSION=v2

# Aggregate attempted provider calls, UTC. Missing or zero limits block paid AI.
# Set shop-approved limits before paid AI use. These counts are not billing estimates.

# API spending: disabled until explicit request limits and USD allowances are approved.
GEMINI_ENABLED=false
# Choose one provider. Groq never automatically falls back to paid Gemini.
AI_PROVIDER=gemini
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Optional fixed beta deadline in UTC, e.g. 2026-11-19T18:09:36Z.
# When set, a positive total beta allowance is required; its ledger never auto-resets.
GEMINI_BETA_EXPIRES_AT=
GEMINI_BETA_BUDGET_USD=0
GEMINI_DAILY_REQUEST_LIMIT=0
GEMINI_MONTHLY_REQUEST_LIMIT=0
GEMINI_DAILY_BUDGET_USD=0
GEMINI_MONTHLY_BUDGET_USD=0
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
GEMINI_IMAGE_FALLBACK_MODEL=
GEMINI_IMAGE_ENABLED=false
GEMINI_PROJECT_RPM=10
GEMINI_USER_RPM=5
GEMINI_USER_DAILY_LIMIT=20
GEMINI_USER_MONTHLY_LIMIT=200
AI_ALERT_EMAIL_ENABLED=false
